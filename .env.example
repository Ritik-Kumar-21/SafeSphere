# ================================================================
# EMBER — Fire & Emergency SMS Prototype Configuration
# ================================================================

# Application Settings
FLASK_APP=app.py
FLASK_ENV=development
PORT=5001
SECRET_KEY=ember_tactical_emergency_secret_key_2026

# SMS Provider Selection: 'demo' or 'twilio'
# Keep as 'demo' for risk-free zero-cost local testing and presentations.
# Switch to 'twilio' when ready to send real cellular SMS messages.
SMS_PROVIDER=demo

# Twilio API Credentials (Required ONLY if SMS_PROVIDER=twilio)
# Retrieve these from your Twilio Console at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here
